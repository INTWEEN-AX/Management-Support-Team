/** Synthetic HWPX examples only. No company/person records or Drive uploads. */
var SYNTHETIC_HWPX_EXAMPLES = {
  staff: '',
  performance: ''
};

/** Return a prefilled, synthetic HWPX file for the public proposal demo. */
function getSyntheticProposalExample(kind) {
  kind = String(kind || '');
  if (!Object.prototype.hasOwnProperty.call(SYNTHETIC_HWPX_EXAMPLES, kind)) {
    throw new Error('지원하지 않는 합성 예시 양식입니다.');
  }
  return {
    name: kind === 'staff' ? '합성_참여인력_예시.hwpx' : '합성_수행실적_예시.hwpx',
    dataBase64: SYNTHETIC_HWPX_EXAMPLES[kind],
    synthetic: true
  };
}
