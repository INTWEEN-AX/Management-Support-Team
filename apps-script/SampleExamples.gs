/**
 * Synthetic HWPX examples only. No company/person records, no sheet/Drive access.
 * These are BLANK, fillable templates whose table structures intentionally differ
 * (title row + header row, different column order, label table + two repeat tables).
 * Contacts, addresses, resident IDs, salary and birth dates never appear here.
 */
var SYNTHETIC_HWPX_EXAMPLES = {
  staff: '',
  performance: '',
  mixed: ''
};

var SYNTHETIC_EXAMPLE_META = {
  staff:       { name: '합성_참여인력_서식.hwpx',   label: '참여인력 현황표 (제목행 + 머리글 + 빈 6행)' },
  performance: { name: '합성_수행실적_서식.hwpx',   label: '유사용역 수행실적표 (열 순서가 다름)' },
  mixed:       { name: '합성_종합서식.hwpx',        label: '일반현황 라벨표 + 인력표 + 실적표 (한 문서에 표 3개)' }
};

/** Fake rows used only by the "예시로 체험" button. Never read from or written to the sheet. */
var SYNTHETIC_DEMO_ROWS = {
  company: { name: '가상기획 주식회사', ceo: '김가상', bizNo: '000-00-00000', _missing: [], _dummy: [] },
  bid: { bidName: '2026 가상 지역 홍보 용역', bidNo: 'DEMO-0001', bidOrg: '가상시청', bidDemandOrg: '가상시청 홍보과', today: '2026. 01. 01.' },
  hr: [
    { name: '가상일', dept: '기획팀', position: '팀장', edu: '가상대학교 학사', eduSchool: '가상대학교', eduMajor: '경영학', eduDegree: '학사', career: '12년', joinDate: '2016-03-01' },
    { name: '가상이', dept: '운영팀', position: '책임', edu: '가상대학교 석사', eduSchool: '가상대학교', eduMajor: '미디어학', eduDegree: '석사', career: '8년', joinDate: '2019-07-01' },
    { name: '가상삼', dept: '디자인팀', position: '선임', edu: '', eduSchool: '', eduMajor: '', eduDegree: '', career: '', joinDate: '' }
  ],
  perf: [
    { taskName: '가상 도시 브랜드 홍보 용역', org: '가상시청', amount: '120,000,000', period: '2024.03~2024.12', contractDate: '2024-03-01', desc: '합성 예시 사업' },
    { taskName: '가상 축제 운영 대행', org: '가상문화재단', amount: '85,000,000', period: '2025.04~2025.10', contractDate: '2025-04-01', desc: '합성 예시 사업' }
  ]
};

function getSyntheticProposalExample(kind) {
  kind = String(kind || '');
  if (!Object.prototype.hasOwnProperty.call(SYNTHETIC_HWPX_EXAMPLES, kind)) {
    throw new Error('지원하지 않는 합성 예시 양식입니다.');
  }
  return {
    name: SYNTHETIC_EXAMPLE_META[kind].name,
    label: SYNTHETIC_EXAMPLE_META[kind].label,
    dataBase64: SYNTHETIC_HWPX_EXAMPLES[kind],
    synthetic: true
  };
}

/** 예시 서식을 가상 인력·실적으로 채워 결과와 검토 정보를 돌려준다 (실제 데이터·시트 접근 없음). */
function runSyntheticDemo(kind) {
  var example = getSyntheticProposalExample(kind);
  var result = fillCore_({ name: example.name, dataBase64: example.dataBase64, demoRows: SYNTHETIC_DEMO_ROWS }, false);
  result.source = { name: example.name, dataBase64: example.dataBase64 };   // 채우기 전 원본 템플릿
  return result;
}
