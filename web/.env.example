# P2 AX 전용. 값은 승인된 환경에 직접 설정합니다. 다른 프로젝트와 공유하지 마세요.
# https://oancjcvjtpbipodewjki.supabase.co (프로젝트 URL)
NEXT_PUBLIC_SUPABASE_URL=
# Supabase Connect 대시보드의 publishable key만 허용. service role/secret key 금지
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Google 공급자·redirect 설정 확인 후 true. 기본은 이메일 로그인만 사용
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=false
